# Copy to .env and fill in; .env is never committed.
# 複製成 .env 後填入；.env 不會進版控。
# Quote values that contain spaces or "#". 2.4 GHz networks only.
# 值含空白或 # 時用雙引號包起來。只支援 2.4 GHz。
# Leave WIFI_PASSWORD empty for an open network. 開放網路請讓 WIFI_PASSWORD 留空。
WIFI_SSID=<YOUR_WIFI_SSID>
WIFI_PASSWORD=<YOUR_WIFI_PASSWORD>
